{
	"root": true,
	"extends": "wikimedia/common",
	"globals": {
		"OO": false
	},
	"overrides": [
		{
			"files": [
				"src/**/*.js",
				"tests/setup-browser.js"
			],
			"extends": "wikimedia/client/es6",
			"rules": {
				"no-implicit-globals": "off"
			}
		},
		{
			"files": [
				"tests/**/*.js"
			],
			"extends": [
				"wikimedia/client",
				"wikimedia/qunit"
			]
		},
		{
			"files": [
				"Gruntfile.js",
				"web-test-runner.*.mjs",
				"tests/wtr.conf.base.mjs"
			],
			"extends": "wikimedia/server"
		},
		{
			"files": [
				"tests/wtr-qunit-adapter.js"
			],
			"extends": "wikimedia/client",
			"parserOptions": {
				"ecmaVersion": 2020,
				"sourceType": "module"
			}
		}
	]
}
